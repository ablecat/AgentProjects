         f"{finding.source}: {finding.severity}: {finding.message}\n"
         for finding in findings
     )
+
+
+def summarize_by_severity(
+    findings: list[Finding],
+) -> tuple[SeveritySummary, ...]:
+    """Group findings without changing severity or evidence order."""
+
+    order: list[str] = []
+    grouped: dict[str, list[Finding]] = {}
+    for finding in findings:
+        severity = finding.severity.strip().casefold()
+        if not severity:
+            raise ValueError("finding severity must not be blank")
+        if severity not in grouped:
+            order.append(severity)
+            grouped[severity] = []
+        grouped[severity].append(finding)
+    return tuple(
+        SeveritySummary(severity, len(grouped[severity]), tuple(grouped[severity]))
+        for severity in order
+    )
